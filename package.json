{
  "name": "profile_project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"{src,tests}/**/*.{ts,tsx}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "dev:e2e": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "test:e2e": "start-server-and-test dev:e2e http://127.0.0.1:5174 cypress:run",
    "cypress:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "preview": "vite preview",
    "prepare": "husky",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "cypress:run": "cypress run",
    "e2e": "docker compose up -d --build && npx wait-on http://127.0.0.1:5174 && cypress run && docker compose down"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.0",
    "@mui/material": "^9.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cypress": "^15.17.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "start-server-and-test": "^3.0.11",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "{src,tests}/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
